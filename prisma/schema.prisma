generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id             String    @id @default(cuid())
  name           String
  pinHash        String
  pinLookup      String    @unique
  role           String    @default("STAFF") // ADMIN, MANAGER, STAFF
  canScan        Boolean   @default(true)
  active         Boolean   @default(true)
  sessionVersion Int       @default(0)
  History        History[]
}

// Persistent failed-login counters. Keyed by client address, not by PIN.
model LoginThrottle {
  key         String    @id
  failures    Int       @default(0)
  windowStart DateTime
  lockedUntil DateTime?
}

model Location {
  id       String         @id @default(cuid())
  name     String         @unique
  balances StockBalance[]
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  items Item[]
}

model Item {
  id           String    @id @default(cuid())
  name         String
  sku          String    @unique
  description  String?
  threshold    Int       @default(5) // Low stock warning level for the total across locations
  categoryId   String
  category     Category  @relation(fields: [categoryId], references: [id])
  qrCodeData   String    @unique // The string encoded in the QR
  receivedAt   DateTime? @default(now())
  outOfStockAt DateTime?
  isManualOos  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  balances     StockBalance[]
  History      History[]
}

// One balance per catalog item and physical location. Item.quantity is not stored.
model StockBalance {
  id         String   @id @default(cuid())
  itemId     String
  locationId String
  quantity   Int      @default(0)
  item       Item     @relation(fields: [itemId], references: [id])
  location   Location @relation(fields: [locationId], references: [id])

  @@unique([itemId, locationId])
}

model History {
  id             String   @id @default(cuid())
  itemId         String
  item           Item     @relation(fields: [itemId], references: [id])
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  actorName                     String?
  action                        String // "ADD", "REMOVE", "AUDIT", "NEW_ITEM", "TRANSFER"
  amount                        Int
  quantityBefore                Int?
  quantityAfter                 Int?
  locationName                  String?
  fromLocationName              String?
  toLocationName                String?
  sourceQuantityBefore          Int?
  sourceQuantityAfter           Int?
  destinationQuantityBefore     Int?
  destinationQuantityAfter      Int?
  reason                        String?
  requestId                     String?  @unique
  timestamp                     DateTime @default(now())
}
