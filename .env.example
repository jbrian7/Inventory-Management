DATABASE_URL="file:./dev.db"
# Name shown for this deployment. One database and one printer belong to one business.
# Leave it blank to show "Your business". This deployment is Zap Zone.
BUSINESS_NAME="Zap Zone"
AUTH_SECRET="replace-with-a-long-random-string"
# HMAC pepper for PIN lookup keys. At least 16 characters.
# Store it with the database backups. Replacing it makes existing PINs unverifiable.
# It is not a PIN and it does not belong in git.
PIN_PEPPER="replace-with-a-different-long-random-string"
# Leave unset on the store LAN. Set to 1 only when a reverse proxy you control
# replaces X-Forwarded-For. The app then uses the last address in that header.
# TRUST_PROXY="1"
# Development seed only. Never set this on a production database.
# ZAP_ALLOW_SEED="1"
# Label printer on the store LAN. Keep the token on the server. Do not put it in the browser.
# PRINT_SERVER_URL="http://192.168.1.50:3001"
# PRINT_SERVER_TOKEN="replace-with-a-long-random-string"
# sqlite (default) or google_sheets. Only one backend is written. Do not point both at live data.
# STORAGE_BACKEND="sqlite"
# Spreadsheet for this business when STORAGE_BACKEND=google_sheets.
# SPREADSHEET_ID=""
# Service account JSON. Prefer a file outside the repo over pasting it here.
# GOOGLE_APPLICATION_CREDENTIALS="/secure/google-service-account.json"
# GOOGLE_SERVICE_ACCOUNT_JSON=""
# Public https origin used on tote QR labels, with no path.
# It must not be localhost or a LAN address. Phones scan the printed URL.
# PUBLIC_BASE_URL="https://inventory.example.com"
# Set TRUST_PROXY=1 in front of that public https proxy so tote page limits are per visitor.
