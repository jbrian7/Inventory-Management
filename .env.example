DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-string"
# HMAC pepper for PIN lookup keys. At least 16 characters.
# Store it with the database backups. Replacing it makes existing PINs unverifiable.
# It is not a PIN and it does not belong in git.
PIN_PEPPER="replace-with-a-different-long-random-string"
